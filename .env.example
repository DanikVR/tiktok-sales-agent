# ── required ──
DATABASE_URL=postgres://commerce:commerce@localhost:5432/commerce
ANTHROPIC_API_KEY=sk-ant-...
# Bearer token for the owner console (/console) and the admin API. Any long random string.
ADMIN_TOKEN=change-me-to-a-long-random-string
# Key for AES-256-GCM encryption of API keys saved from the console (any long random string).
APP_SECRET=change-me-too

# ── optional ──
PORT=3001
PUBLIC_BASE_URL=https://shop.example.com        # absolute links in the widget, OG previews, Telegram
COMMERCE_SHOPPING_MODEL=claude-sonnet-5          # shopping agent (latency matters)
COMMERCE_MERCHANT_MODEL=claude-opus-5            # merchant agent (analysis matters)
GEMINI_API_KEY=                                  # video → text for TikTok / Instagram / Telegram catalog import
GEMINI_FLASH_MODEL=gemini-2.5-flash
COMMERCE_TELEGRAM_BOT_TOKEN=                     # owner notifications bot (leads, digests); /start links the chat
SMTP_HOST=                                       # owner notifications by e-mail (leads, daily digest); leave empty to disable
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Commerce Agents <noreply@example.com>
VAPID_PUBLIC_KEY=                                # web push to shoppers: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
# Instagram catalog import (optional sidecar, see services/ig-gateway in the instagram-sales-agent repo)
IG_GATEWAY_URL=
IG_GATEWAY_SECRET=
# TikTok / Telegram import tools
YTDLP_BIN=yt-dlp
SOCIAL_TMP_DIR=/tmp/commerce-social
TENANT_ID=default
