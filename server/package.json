{
  "name": "tiktok-sales-agent-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI sales agent for TikTok: turns a public TikTok profile into a product catalog (yt-dlp + Gemini) and sells through an embeddable Claude commerce agent.",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx src/migrate.ts",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@google/genai": "^2.8.0",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "multer": "^2.1.1",
    "pg": "^8.11.0",
    "sharp": "^0.33.5",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.7.0",
    "typescript": "^5.2.0"
  }
}
